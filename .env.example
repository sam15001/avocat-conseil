# ───────────────────────────────────────────────────────────────
# AVOCAT & CONSEIL — variables d'environnement
# En production : Netlify > Site configuration > Environment variables
# En local : copier ce fichier en .env et remplir
# NE JAMAIS committer le fichier .env
# ───────────────────────────────────────────────────────────────

# URL publique du site, sans slash final (sert au callback OAuth et aux liens Discord)
SITE_URL=https://avocat-conseil.netlify.app

# Secret de signature des sessions (64 caractères aléatoires minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Base de données Firebase Realtime Database (console.firebase.google.com)
# Adresse affichée en haut de la page Realtime Database, sans / final
FIREBASE_DATABASE_URL=https://votre-projet-default-rtdb.europe-west1.firebasedatabase.app
# Méthode 1 (la plus simple) : Paramètres du projet > Comptes de service > Codes secrets de la base de données
FIREBASE_DATABASE_SECRET=
# Méthode 2 (si les codes secrets ne sont pas proposés) : Comptes de service > Générer une nouvelle clé privée,
# puis recopier "client_email" et "private_key" du fichier téléchargé (laisser FIREBASE_DATABASE_SECRET vide)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Application Discord (https://discord.com/developers/applications)
# General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# OAuth2
DISCORD_CLIENT_SECRET=
# Bot > Reset Token
DISCORD_BOT_TOKEN=
# Clic droit sur le serveur > Copier l'identifiant (mode développeur activé)
DISCORD_GUILD_ID=
# true : seuls les membres du serveur Discord peuvent se connecter
DISCORD_REQUIRE_MEMBER=true

# ── Salons Discord (modifiables ensuite depuis Administration > Paramètres)
DISCORD_CHANNEL_REQUESTS=
DISCORD_CHANNEL_APPOINTMENTS=
DISCORD_CHANNEL_ACTIVE=
DISCORD_CHANNEL_CLOSED=
DISCORD_CHANNEL_ADMIN=
# Salon d'accueil (message épinglé avec les boutons vers le site)
DISCORD_CHANNEL_WELCOME=

# ── Rôles Discord (modifiables ensuite depuis Administration > Paramètres)
# Plusieurs identifiants possibles, séparés par des virgules
DISCORD_ROLE_AVOCAT=
DISCORD_ROLE_RESPONSABLE=
DISCORD_ROLE_DIRECTION=

# Envoyer un message privé de confirmation au citoyen (true/false)
DISCORD_DM_CONFIRMATIONS=true

# Fuseau horaire du cabinet (affichage des dates dans Discord)
CABINET_TIMEZONE=Europe/Paris
